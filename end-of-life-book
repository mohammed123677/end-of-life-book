        // Populate Chapter Cards
        function renderChapters(chaptersToRender) {
            const grid = document.getElementById('chapters-grid');
            grid.innerHTML = '';

            chaptersToRender.forEach(ch => {
                const card = document.createElement('div');
                card.className = 'bg-brand-card p-6 rounded-2xl border border-brand-border flex flex-col justify-between gold-border-glow transition-all';
                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20">Ch. ${ch.num}</span>
                            <span class="text-xs text-gray-400 font-medium">${ch.category}</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2 leading-snug">${ch.title}</h3>
                        <p class="text-xs text-gray-400 leading-relaxed mb-4">${ch.summary}</p>
                    </div>
                    <div>
                        <div class="p-3 rounded-xl bg-brand-dark/70 border border-brand-border mb-4 text-xs text-amber-300 font-medium">
                            <i class="fa-solid fa-key mr-1 text-amber-400"></i> ${ch.takeaway}
                        </div>
                        <button onclick="openModal(${ch.num})" class="w-full py-2.5 rounded-xl bg-brand-border hover:bg-gray-700 text-white font-semibold text-xs transition-colors flex items-center justify-center gap-2">
                            <i class="fa-solid fa-book-open text-amber-400"></i> Read Chapter Preview
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Search and Category Filter logic
        function filterChapters() {
            const searchQuery = document.getElementById('chapter-search').value.toLowerCase();
            const categoryQuery = document.getElementById('tag-filter').value;

            const filtered = chapterData.filter(ch => {
                const matchesSearch = ch.title.toLowerCase().includes(searchQuery) || ch.summary.toLowerCase().includes(searchQuery);
                const matchesCategory = (categoryQuery === 'ALL') || (ch.category === categoryQuery);
                return matchesSearch && matchesCategory;
            });

            renderChapters(filtered);
        }

        // Modal Reader
        function openModal(chNum) {
            const ch = chapterData.find(item => item.num === chNum) || chapterData[0];
            document.getElementById('modal-chapter-number').innerText = `Chapter ${ch.num}`;
            document.getElementById('modal-chapter-title').innerText = ch.title;
            document.getElementById('modal-chapter-body').innerHTML = ch.content;

            const modal = document.getElementById('chapter-modal');
            const container = document.getElementById('modal-container');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                container.classList.remove('scale-95');
            }, 10);
        }

        function closeModal() {
            const modal = document.getElementById('chapter-modal');
            const container = document.getElementById('modal-container');
            modal.classList.add('opacity-0');
            container.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // Habit Tracker Widget State
        let habitState = [false, false, false, false];

        function toggleHabit(index) {
            habitState[index] = !habitState[index];
            updateHabitUI();
        }

        function updateHabitUI() {
            const items = document.querySelectorAll('.habit-item');
            let completedCount = 0;

            habitState.forEach((isDone, idx) => {
                const checkbox = items[idx].querySelector('.habit-checkbox');
                const icon = checkbox.querySelector('i');

                if (isDone) {
                    completedCount++;
                    items[idx].classList.add('border-emerald-500/50', 'bg-emerald-500/10');
                    checkbox.classList.add('bg-emerald-500', 'border-emerald-500', 'text-black');
                    icon.classList.remove('opacity-0');
                } else {
                    items[idx].classList.remove('border-emerald-500/50', 'bg-emerald-500/10');
                    checkbox.classList.remove('bg-emerald-500', 'border-emerald-500', 'text-black');
                    icon.classList.add('opacity-0');
                }
            });

            const percent = Math.round((completedCount / habitState.length) * 100);
            document.getElementById('completion-percentage').innerText = `${percent}%`;
        }

        function resetTracker() {
            habitState = [false, false, false, false];
            updateHabitUI();
        }

        // Suggestion Form Handler
        function handleSuggestion(e) {
            e.preventDefault();
            document.getElementById('form-feedback').classList.remove('hidden');
            e.target.reset();
            setTimeout(() => {
                document.getElementById('form-feedback').classList.add('hidden');
            }, 4000);
        }

        // On Load Initializations
        window.onload = function() {
            renderChapters(chapterData);
            document.getElementById('tracker-date').innerText = `Today's Protocol (${new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' })})`;
        };
    </script>
</body>
